{
  "manifest_version": 3,
  "name": "Cardmarket Wants Optimizer",
  "version": "0.1.0",
  "description": "Inspect Cardmarket want lists and prepare seller data for optimization.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://www.cardmarket.com/*",
    "https://*.execute-api.eu-central-1.amazonaws.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cardmarket Wants Optimizer"
  }
}