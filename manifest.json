{
  "manifest_version": 3,
  "name": "Cardmarket Optimizer",
  "version": "0.1.0.4",
  "description": "Save some money on your next Magic cards: this plugin computes the optimal order for you.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "https://cardmarket.com/*",
    "https://www.cardmarket.com/*",
    "https://h2ilohl6ll.execute-api.eu-central-1.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cardmarket Optimizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}